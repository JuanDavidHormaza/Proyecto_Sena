# ==============================================================================
# WorkLex SENA - Plantilla de Variables de Entorno (.env.example)
# Adaptado para Producción VPS Clouding (https://worklexsena.shop)
# ==============================================================================

# ── 1. IP Pública y Dominio del Servidor ──────────────────────────────────────
SERVER_IP=185.253.155.157
PUBLIC_IP=185.253.155.157
DOMAIN_NAME=worklexsena.shop
DOMAIN_OR_IP=worklexsena.shop

# ── 2. Orquestación Docker Compose ─────────────────────────────────────────────
COMPOSE_PROJECT_NAME=worklex

# ── 3. Backend Django (Gunicorn / API REST) ───────────────────────────────────
DEBUG=False
DJANGO_SECRET_KEY=cambiar_por_clave_secreta_django_en_produccion
DJANGO_PORT=8000
VITE_PORT=5173

# Hosts autorizados para Django
ALLOWED_HOSTS=localhost,127.0.0.1,worklex_backend,worklex_proxy,185.253.155.157,worklexsena.shop,www.worklexsena.shop

# CORS y CSRF para el navegador y frontend
CORS_ALLOWED_ORIGINS=https://worklexsena.shop,https://www.worklexsena.shop,http://185.253.155.157,http://localhost:5173,http://localhost
CSRF_TRUSTED_ORIGINS=https://worklexsena.shop,https://www.worklexsena.shop,http://185.253.155.157

# URLs de interconexión interna y pública
BACKEND_URL=http://worklex_backend:8000
VITE_API_URL=/api
VITE_MEDIA_URL=https://worklexsena.shop

# ── 4. Base de Datos Relacional PostgreSQL (worklex_persistencia) ──────────────
POSTGRES_DB=SENA
POSTGRES_USER=admin
POSTGRES_PASSWORD=cambiar_password_postgres
POSTGRES_HOST=worklex_persistencia
POSTGRES_PORT=5432
DATABASE_URL=postgres://admin:cambiar_password_postgres@worklex_persistencia:5432/SENA

# ── 5. MinIO S3 Object Storage (worklex_minio - Red Interna Docker) ───────────
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=cambiar_password_minio
MINIO_ENDPOINT=worklex_minio:9000
MINIO_USER=admin
MINIO_PASSWORD=cambiar_password_minio
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=cambiar_password_minio
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=https://worklexsena.shop/minio
MINIO_PUBLIC_URL_PREFIX=/api/media/

# ── 6. Seguridad y Autenticación JWT Nativa ────────────────────────────────────
JWT_SECRET_KEY=cambiar_por_jwt_secret_largo_en_produccion
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7

# ── 7. Correo Institucional / SMTP (Envío de OTP y Notificaciones) ────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=sworklex@gmail.com
EMAIL_HOST_PASSWORD=tu_app_password_sin_espacios
DEFAULT_FROM_EMAIL=sworklex@gmail.com

# ── 8. ElevenLabs TTS (Síntesis de Voz Vocabulario ADSO) ───────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── 9. Identity Provider: Keycloak (Perfil 'auth') ────────────────────────────
KEYCLOAK_USER=admin
KEYCLOAK_PASSWORD=cambiar_password_keycloak
KC_PROXY=edge
KC_PROXY_HEADERS=xforwarded
KC_HOSTNAME=worklexsena.shop
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false
KC_HTTP_ENABLED=true
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://worklex_persistencia:5432/SENA
KC_DB_USERNAME=admin
KC_DB_PASSWORD=cambiar_password_postgres

# ── 10. Secret Management: HashiCorp Vault (Perfil 'vault') ───────────────────
VAULT_DEV_ROOT_TOKEN_ID=cambiar_token_vault_master
VAULT_ADDR=http://127.0.0.1:8200

# ── 11. Certificados Let's Encrypt / Certbot ──────────────────────────────────
LETSENCRYPT_EMAIL=admin@worklexsena.shop
LETSENCRYPT_DOMAIN=worklexsena.shop
