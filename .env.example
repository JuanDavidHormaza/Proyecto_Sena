# ==============================================================================
# WorkLex SENA - Archivo de Configuración de Entorno (.env / .env.example)
# Adaptado para VPS Linux Ubuntu 24.04 (1 vCPU / 2GB RAM / IP Pública)
# ==============================================================================

# ── 1. IP PÚBLICA O DOMINIO DEL SERVIDOR (CAMBIAR SOLO ESTA LÍNEA MAÑANA) ─────
SERVER_IP=TU_IP_AQUI
# Ejemplos:
# SERVER_IP=203.161.47.73
# SERVER_IP=worklex.sena.edu.co

PUBLIC_IP=${SERVER_IP}
DOMAIN_OR_IP=${SERVER_IP}

# ── 2. Orquestación Docker Compose ─────────────────────────────────────────────
# Por defecto se levanta el stack núcleo (Backend + Frontend + DB + MinIO + WAF Proxy).
# Los servicios pesados auxiliares (Keycloak, Vault, Certbot, Firewall) se gestionan con perfiles.
COMPOSE_FILE=docker-compose.yml:docker-compose.db.yml:docker-compose.media.yml:docker-compose.proxy.yml:docker-compose.auth.yml:docker-compose.vault.yml:docker-compose.firewall.yml
COMPOSE_PATH_SEPARATOR=:

# ── 3. Entorno de Ejecución Backend (Django) ───────────────────────────────────
DEBUG=False
DJANGO_SECRET_KEY=wlx_prod_sena_k9f3j29d02kd92jd02kd092jd902kd02kd902jd02kd902
DJANGO_PORT=8000
VITE_PORT=5173

# Hosts permitidos para Django (evita DisallowedHost)
ALLOWED_HOSTS=localhost,127.0.0.1,worklex_backend,${SERVER_IP},worklex.sena.edu.co

# CORS y CSRF para permitir consumo desde navegador y frontend
CORS_ALLOWED_ORIGINS=http://${SERVER_IP},http://${SERVER_IP}:5173,http://${SERVER_IP}:8000,http://localhost:5173,http://localhost
CSRF_TRUSTED_ORIGINS=http://${SERVER_IP},http://${SERVER_IP}:5173,http://${SERVER_IP}:8000,http://localhost:5173,http://localhost

# URLs de interconexión
BACKEND_URL=http://worklex_backend:8000
VITE_API_URL=/api
VITE_MEDIA_URL=http://${SERVER_IP}

# ── 4. Base de Datos Relacional PostgreSQL (worklex_persistencia) ──────────────
POSTGRES_DB=SENA
POSTGRES_USER=worklex_admin
POSTGRES_PASSWORD=Wlx_Sena_SecurePass_2026*!
POSTGRES_HOST=worklex_persistencia
POSTGRES_PORT=5432
DATABASE_URL=postgres://worklex_admin:Wlx_Sena_SecurePass_2026*!@worklex_persistencia:5432/SENA

# ── 5. MinIO S3 Object Storage (worklex_minio) ────────────────────────────────
# Puerto 9000 para API S3, puerto 9001 para Consola Administrativa Web
MINIO_ROOT_USER=worklex_minio_root
MINIO_ROOT_PASSWORD=Minio_Sena_SecretPass_2026*!
MINIO_ENDPOINT=worklex_minio:9000
MINIO_USER=worklex_minio_root
MINIO_PASSWORD=Minio_Sena_SecretPass_2026*!
MINIO_ACCESS_KEY=worklex_minio_root
MINIO_SECRET_KEY=Minio_Sena_SecretPass_2026*!
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://${SERVER_IP}/minio
MINIO_PUBLIC_URL_PREFIX=/api/media/

# ── 6. Seguridad y Autenticación JWT Nativa ────────────────────────────────────
JWT_SECRET_KEY=wlx_jwt_production_master_key_9823479812374981273981273918237918237
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7

# ── 7. Correo Institucional / SMTP (Envío de OTP y Notificaciones) ────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=sworklex@gmail.com
EMAIL_HOST_PASSWORD=tu_contrasena_de_aplicacion_aqui
DEFAULT_FROM_EMAIL=sworklex@gmail.com

# ── 8. ElevenLabs TTS (Síntesis de Voz Vocabulario Técnico ADSO) ───────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── 9. Identity Provider: Keycloak (Quarkus Engine) ───────────────────────────
# Configurado para correr con límites JVM sobre servidores de 2GB RAM
KEYCLOAK_USER=admin
KEYCLOAK_PASSWORD=Keycloak_Admin_2026*!
KC_PROXY=edge
KC_HOSTNAME=${SERVER_IP}
KC_HOSTNAME_STRICT=false
KC_HTTP_ENABLED=true
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://worklex_persistencia:5432/SENA
KC_DB_USERNAME=worklex_admin
KC_DB_PASSWORD=Wlx_Sena_SecurePass_2026*!

# ── 10. Secret Management: HashiCorp Vault ────────────────────────────────────
VAULT_DEV_ROOT_TOKEN_ID=wlx_vault_master_token_2026
VAULT_ADDR=http://127.0.0.1:8200

# ── 11. Certbot / Let's Encrypt (Habilitar solo cuando exista un dominio FQDN) ─
# LETSENCRYPT_EMAIL=admin@sena.edu.co
# LETSENCRYPT_DOMAIN=worklex.sena.edu.co
