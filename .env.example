# ==============================================================================
# WorkLex SENA - Archivo de Configuración de Variables de Entorno (.env.example)
# Copia este archivo a `.env` y ajusta los valores para tu entorno local/producción.
# ==============================================================================

# ── Orquestación Unificada de Docker Compose ───────────────────────────────────
COMPOSE_FILE=docker-compose.yml:docker-compose.db.yml:docker-compose.media.yml:docker-compose.proxy.yml:docker-compose.vault.yml:docker-compose.firewall.yml:docker-compose.auth.yml
COMPOSE_PATH_SEPARATOR=:

# ── Entorno de Ejecución y Puertos ─────────────────────────────────────────────
DEBUG=True
DJANGO_PORT=8000
VITE_PORT=5173
BACKEND_URL=http://worklex_backend:8000
VITE_API_URL=/api

# ── Base de Datos Relacional PostgreSQL (worklex_persistencia) ─────────────────
POSTGRES_DB=SENA
POSTGRES_USER=admin
POSTGRES_PASSWORD=Admin123*
POSTGRES_HOST=worklex_persistencia
POSTGRES_PORT=5432

# ── MinIO S3 Object Storage (worklex_minio) ───────────────────────────────────
# Endpoint interno de Docker para MinIO (puerto 9000 para API S3, 9001 para consola web)
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=Admin123*
MINIO_USER=admin
MINIO_PASSWORD=Admin123*
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=Admin123*
MINIO_USE_SSL=false
MINIO_PUBLIC_URL_PREFIX=/api/media/

# ── Seguridad y Autenticación JWT ──────────────────────────────────────────────
JWT_SECRET_KEY=worklex_sena_super_secret_jwt_key_2026_change_in_production
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7

# ── Correo Institucional / SMTP (Envío de OTP y Notificaciones) ───────────────
# En desarrollo sin conexión a internet, se usa fallback de consola o OTP 123456
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=sworklex@gmail.com
EMAIL_HOST_PASSWORD=tu_contrasena_de_aplicacion_aqui
DEFAULT_FROM_EMAIL=sworklex@gmail.com

# ── ElevenLabs TTS (Síntesis de Voz Nativa - Backend Only) ─────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── Servicios de Identidad y Secretos (Keycloak & HashiCorp Vault) ─────────────
KEYCLOAK_USER=admin
KEYCLOAK_PASSWORD=Admin123*
VAULT_DEV_ROOT_TOKEN_ID=worklex_root_token
